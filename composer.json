{
    "name": "yonld/purephp",
    "type": "library",
    "description": "Pure is a PHP template engine inspired by ReactJS.",
    "license": "MIT",
    "homepage": "https://github.com/YonLD/purephp",
    "bin": [
        "bin/pure"
    ],
    "autoload": {
        "psr-4": {
            "Pure\\": "src/"
        },
        "files": [
            "src/Component/functions.php",
            "src/HTML/functions.php",
            "src/SVG/functions.php",
            "src/Utils/functions.php"
        ]
    },
    "scripts": {
        "test": "phpunit tests/",
        "test-coverage": "phpunit --coverage-html coverage/",
        "test-coverage-clover": "phpunit --coverage-clover coverage.xml",
        "syntax-check": "find src tests -name '*.php' -exec php -l {} \\; && php -l bin/pure",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse",
        "bench": "php bench/compare.php",
        "quality": [
            "@syntax-check",
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "authors": [
        {
            "name": "YonLD",
            "email": "istintin@outlook.com"
        }
    ],
    "support": {
        "source": "https://github.com/YonLD/purephp",
        "issues": "https://github.com/YonLD/purephp/issues"
    },
    "require": {
        "php": ">=8.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "friendsofphp/php-cs-fixer": "^3.84",
        "phpstan/phpstan": "^2.1"
    },
    "keywords": [
        "php",
        "templating-engine",
        "template",
        "render",
        "virtual-dom",
        "vdom",
        "html5",
        "xml"
    ],
    "archive": {
        "exclude": [
            "tests/",
            "examples/",
            "site/",
            ".github/",
            ".php-cs-fixer.php",
            "phpstan.neon",
            "phpunit.xml",
            ".phpunit.cache/",
            "coverage/",
            "coverage.xml",
            ".php-cs-fixer.cache"
        ]
    }
}
